# Every variable the agent reads, in the order copilot/config.py reads them. Copy to .env (gitignored) for local
# runs; on Railway set them as service variables. Secrets never have defaults — the agent boots without them and
# fails on the first request that needs one, so set them before you expect a SMART launch to work.
#
# The values below are the LOCAL stack's (deploy/local/compose.yml). Anything marked "optional" can be left out.

# --- OpenEMR -----------------------------------------------------------------------------------------------------
# The FHIR base the agent calls. Inside the local compose network OpenEMR answers on its service name.
OPENEMR_FHIR_BASE=http://openemr/apis/default/fhir
# The FHIR base as OpenEMR advertises it in tokens (its site_addr_oath). Must match the launch iss/aud or the
# launch is rejected. Optional: defaults to OPENEMR_FHIR_BASE, which is right only when they are the same host.
PUBLIC_ISSUER=http://localhost:8300/apis/default/fhir
# Optional, all derived from the two above. Set them when the browser and the agent reach OpenEMR at different
# addresses — which is exactly the local case, where the browser uses localhost:8300 and the agent uses openemr.
OAUTH_PUBLIC_BASE=http://localhost:8300/oauth2/default
OAUTH_INTERNAL_BASE=http://openemr/oauth2/default
OPENEMR_PUBLIC_ORIGIN=http://localhost:8300
# From OpenEMR's SMART app registration (Admin -> System -> API Clients). Without these there is no SMART launch.
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
# Parallel FHIR calls. Keep it below OpenEMR's PHP worker count (ARCHITECTURE section 3, AUDIT PERF-1). Optional.
OPENEMR_CONCURRENCY=6

# --- Agent -------------------------------------------------------------------------------------------------------
# Where browsers reach the agent; used to build the OAuth redirect URI. Optional, defaults to http://localhost:8000.
AGENT_PUBLIC_URL=http://localhost:8000
# Opens POST /api/sessions, which takes an access token directly instead of a browser launch. Needed for the live
# evals, the Bruno collection and the load tests. Enabled on the demo deployment for graders; false for real PHI.
ALLOW_API_SESSIONS=true
# Comma-separated patient UUIDs that /api/sessions will accept. Synthetic patients only — this is the allowlist
# that keeps the escape hatch above from reaching a real chart.
EVAL_PATIENT_IDS=
# Pseudonymizes ids before they reach Langfuse (AUDIT COMP-3). Required in production; any random 32+ byte string.
HMAC_KEY=
# Live panels per user. 3 is the product default; raise only for a load test (LOAD_TEST.md). Optional.
MAX_SESSIONS_PER_USER=3

# --- LLM ---------------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Wall-clock budget for one question, in seconds. Optional, defaults to 9.
QUESTION_DEADLINE_S=9

# --- Observability -------------------------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Audit trail (the copilot_audit table; see deploy/sql/copilot_audit.sql) ----------------------------------------
# An INSERT-only user on the OpenEMR MySQL, over verified TLS. Leave unset and the agent refuses to answer rather
# than disclose a chart it cannot audit (FM-15), so set these before a real walkthrough.
AUDIT_DB_HOST=mysql
AUDIT_DB_PORT=3306
AUDIT_DB_USER=copilot_audit
AUDIT_DB_PASSWORD=
AUDIT_DB_NAME=copilot
# PEM path of the CA that signed the MySQL server cert. deploy/local/compose.yml mounts it here.
AUDIT_DB_CA=/certs/ca.pem
